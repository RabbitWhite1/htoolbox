#!/usr/bin/env bash

set -euo pipefail

usage() {
	cat <<'USAGE'
version_tag: bump project version and create annotated git tag

Usage:
	version_tag <new_version>

Example:
	version_tag 0.2.0

Actions performed:
	1. Validate version (simple semver: X.Y.Z[pre])
	2. Update version in pyproject.toml
	3. Commit the change ("Bump version to <version>")
	4. Create annotated tag v<version>
	5. Push commit and tag to origin

Environment expectations:
	- git repository initialized and remote 'origin' configured
	- pyproject.toml contains a line: version = "..."

USAGE
}

if [[ $# -ne 1 ]]; then
	usage >&2
	exit 1
fi

VERSION="$1"

# Basic semver (allows pre-release suffix like rc1, a1, -beta, etc.)
if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+([A-Za-z0-9.-]+)?$ ]]; then
	echo "Error: Version '$VERSION' does not match expected pattern." >&2
	exit 1
fi

PYPROJECT="pyproject.toml"
if [[ ! -f $PYPROJECT ]]; then
	echo "Error: $PYPROJECT not found." >&2
	exit 1
fi

CURRENT=$(grep -E '^version *= *"' "$PYPROJECT" | head -1 | sed -E 's/version *= *"([^"]+)"/\1/') || CURRENT=""
if [[ -z "$CURRENT" ]]; then
	echo "Error: Unable to read current version from $PYPROJECT" >&2
	exit 1
fi

if [[ "$CURRENT" == "$VERSION" ]]; then
	echo "Notice: $PYPROJECT already at version $VERSION. Proceeding to retag." >&2
fi

TAG="v$VERSION"

# Prevent accidental overwrite if tag exists remotely or locally
if git rev-parse -q --verify "refs/tags/$TAG" >/dev/null; then
	echo "Error: Tag $TAG already exists. Bump version instead." >&2
	exit 1
fi

echo "Updating $PYPROJECT version $CURRENT -> $VERSION"

# Use awk for in-place replacement, preserving other file lines
tmp_file=$(mktemp)
awk -v newv="$VERSION" 'BEGIN{changed=0} /^version *= *"/ {sub(/".*"/,"\"" newv "\""); changed=1} {print} END{ if(changed==0){exit 2}}' "$PYPROJECT" > "$tmp_file" || {
	status=$?
	rm -f "$tmp_file"
	echo "Error: Failed to update version (awk exit $status)." >&2
	exit 1
}
mv "$tmp_file" "$PYPROJECT"

git add "$PYPROJECT"
if [[ "$CURRENT" == "$VERSION" ]]; then
	git commit -m "Retag version $VERSION"
else
	git commit -m "Bump version to $VERSION"
fi

git tag -a "$TAG" -m "Release $TAG"

echo "Pushing commit to origin main (if branch differs, adjust manually)"
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
git push origin "$CURRENT_BRANCH"
git push origin "$TAG"

echo "Done. Tag $TAG created and pushed."
